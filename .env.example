# Backend Server Port
PORT=5001

# MongoDB Connection URI (MongoDB Atlas or Local MongoDB)
# (Also compatible with MONGO_URI)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/college_events?retryWrites=true&w=majority

# JWT Authentication Secret & Expiry
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
